{
  "info": {
    "name": "GharKaSwad Authentication API",
    "_postman_id": "gharkaswad-auth-v1",
    "description": "Production-grade Authentication and Authorization endpoints for GharKaSwad (Ghar ka khana, apno jaisa sukoon).",
