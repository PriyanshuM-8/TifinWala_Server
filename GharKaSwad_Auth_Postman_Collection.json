      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priyanshu Verma\",\n  \"email\": \"priyanshu@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"CustomerPass@123\",\n  \"confirmPassword\": \"CustomerPass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/customer/register/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "customer", "register", "send-otp"]
        }
      }
    },
